# Non-secret local settings. The current Rust core does not read environment
# variables yet; these names reserve the intended application configuration.
IDROID_ENV=development
IDROID_LOG_LEVEL=info
IDROID_HEARTBEAT_TIMEOUT_MS=30000
IDROID_RECONNECT_GRACE_MS=15000
IDROID_STALE_SESSION_MS=300000
IDROID_TRANSPORT=unimplemented
